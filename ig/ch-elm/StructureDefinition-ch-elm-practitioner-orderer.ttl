         fhir:ElementDefinition.constraint.severity [ fhir:value "warning" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "invalid ZSR number, cannot be processed, must pass the modulus 26 check - https://confluence.sasis.ch/display/PublicZSR/ZSR+Webservice+FAQ" ] ;
