@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://fhir.ch/ig/ch-elm/Practitioner/1cPract-KsAbc> a fhir:Practitioner ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "1cPract-KsAbc"] ;
  fhir:Practitioner.name [
     fhir:index 0 ;
     fhir:HumanName.family [ fhir:value "Giacometti" ] ;
     fhir:HumanName.given [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/data-absent-reason" ] ;
         fhir:Extension.valueCode [ fhir:value "unknown" ]
       ]
     ]
  ] ;
  fhir:Practitioner.address [
     fhir:index 0 ;
     fhir:Address.city [ fhir:value "Bern" ] ;
     fhir:Address.postalCode [ fhir:value "3000" ]
  ] .

# - ontology header ------------------------------------------------------------

<http://fhir.ch/ig/ch-elm/Practitioner/1cPract-KsAbc.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

# -------------------------------------------------------------------------------------

