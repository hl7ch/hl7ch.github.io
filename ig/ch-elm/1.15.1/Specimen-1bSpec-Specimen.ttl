@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://fhir.ch/ig/ch-elm/Specimen/1bSpec-Specimen> a fhir:Specimen ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "1bSpec-Specimen"] ;
  fhir:Specimen.subject [
     fhir:link <http://fhir.ch/ig/ch-elm/Patient/Pat-001> ;
     fhir:Reference.reference [ fhir:value "Patient/Pat-001" ]
  ] ;
  fhir:Specimen.collection [
     fhir:Specimen.collection.collectedDateTime [ fhir:value "2023-07-10T14:10:00+02:00"^^xsd:dateTime ]
  ] .

# - ontology header ------------------------------------------------------------

<http://fhir.ch/ig/ch-elm/Specimen/1bSpec-Specimen.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

# -------------------------------------------------------------------------------------

