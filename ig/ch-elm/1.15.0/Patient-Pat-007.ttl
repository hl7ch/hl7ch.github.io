@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://fhir.ch/ig/ch-elm/Patient/Pat-007> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "Pat-007"] ;
  fhir:Patient.identifier [
     fhir:index 0 ;
     fhir:Identifier.system [ fhir:value "urn:oid:2.16.438.10.20.10.10.1.2.1" ] ;
     fhir:Identifier.value [ fhir:value "1234567890123" ]
  ] ;
  fhir:Patient.name [
     fhir:index 0 ;
     fhir:HumanName.family [ fhir:value "Liechtenstein" ] ;
     fhir:HumanName.given [
       fhir:value "Lilly" ;
       fhir:index 0
     ]
  ] ;
  fhir:Patient.gender [ fhir:value "female"] ;
  fhir:Patient.birthDate [ fhir:value "2000-09-14"^^xsd:date] ;
  fhir:Patient.address [
     fhir:index 0 ;
     fhir:Address.use [ fhir:value "home" ] ;
     fhir:Address.state [ fhir:value "FL" ] ;
     fhir:Address.country [
       fhir:value "LI" ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/iso21090-codedString" ] ;
         fhir:Extension.valueCoding [
           fhir:Coding.system [ fhir:value "urn:iso:std:iso:3166" ] ;
           fhir:Coding.code [ fhir:value "LI" ]
         ]
       ]
     ]
  ] .

# - ontology header ------------------------------------------------------------

<http://fhir.ch/ig/ch-elm/Patient/Pat-007.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

