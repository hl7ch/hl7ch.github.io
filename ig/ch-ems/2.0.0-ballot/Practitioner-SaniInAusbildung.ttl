# - resource -------------------------------------------------------------------

<http://fhir.ch/ig/ch-ems/Practitioner/SaniInAusbildung> a fhir:Practitioner ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "SaniInAusbildung"] ; # 
  fhir:name ( [
     fhir:family [ fhir:v "Sanitaeter" ] ;
     fhir:given ( [ fhir:v "Azubi" ] )
  ] ) ; # 
  fhir:qualification ( [
     fhir:code [
       fhir:coding ( [
         fhir:system [ fhir:v "http://fhir.ch/ig/ch-ems/CodeSystem/IVR"^^xsd:anyURI ] ;
         fhir:code [ fhir:v "1000010" ] ;
         fhir:display [ fhir:v "paramedic-on-training" ]
       ] ) ;
       fhir:text [ fhir:v "Rettungssanitäter/in in Ausbildung" ]
     ]
  ] ) . # 

