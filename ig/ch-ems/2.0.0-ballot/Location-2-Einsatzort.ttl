# - resource -------------------------------------------------------------------

<http://fhir.ch/ig/ch-ems/Location/2-Einsatzort> a fhir:Location ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "2-Einsatzort"] ; # 
  fhir:name [ fhir:v "Sternen Oerlikon"] ; # 
  fhir:address [
     fhir:line ( [ fhir:v "Schaffhauserstr. 350" ] ) ;
     fhir:city [ fhir:v "Zürich" ] ;
     fhir:postalCode [ fhir:v "8050" ] ;
     fhir:country [ fhir:v "CH" ]
  ] ; # 
  fhir:physicalType [
     fhir:coding ( [
       a sct:74964007 ;
       fhir:system [ fhir:v "http://snomed.info/sct"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "74964007" ] ;
       fhir:display [ fhir:v "Other (qualifier value)" ]
     ] ) ;
     fhir:text [ fhir:v "andere / anderes" ]
  ] . # 

