# - resource -------------------------------------------------------------------

<http://fhir.ch/ig/ch-ems/Observation/1-Symptome> a fhir:Observation ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "1-Symptome"] ; # 
  fhir:status [ fhir:v "final"] ; # 
  fhir:code [
     fhir:coding ( [
       a sct:404684003 ;
       fhir:system [ fhir:v "http://snomed.info/sct"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "404684003" ] ;
       fhir:display [ fhir:v "Clinical finding (finding)" ]
     ] )
  ] ; # 
  fhir:subject [
     fhir:link <http://fhir.ch/ig/ch-ems/Patient/1-ThomasMueller> ;
     fhir:reference [ fhir:v "Patient/1-ThomasMueller" ]
  ] ; # 
  fhir:encounter [
     fhir:link <http://fhir.ch/ig/ch-ems/Encounter/1-Einsatz> ;
     fhir:reference [ fhir:v "Encounter/1-Einsatz" ]
  ] ; # 
  fhir:value [
     a fhir:CodeableConcept ;
     fhir:text [ fhir:v "Starke Schmerzen in der Brust und im linken Oberarm verspürt." ]
  ] . # 

