     fhir:coding ( [
       fhir:system [ fhir:v "http://fhir.ch/ig/ch-ems/CodeSystem/IVR"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "1000033" ] ;
       fhir:display [ fhir:v "alarm" ]
     ] ) ;
     fhir:text [ fhir:v "Alarmierungszeit" ]
  ] ; # 
  fhir:subject [
     fhir:link <http://fhir.ch/ig/ch-ems/Patient/1-ThomasMueller> ;
     fhir:reference [ fhir:v "Patient/1-ThomasMueller" ]
  ] ; # 
  fhir:encounter [
     fhir:link <http://fhir.ch/ig/ch-ems/Encounter/1-Einsatz> ;
     fhir:reference [ fhir:v "Encounter/1-Einsatz" ]
  ] ; # 
  fhir:value [
     a fhir:dateTime ;
     fhir:v "2016-12-10T12:09:00.000+01:00"^^xsd:dateTime
  ] . # 

