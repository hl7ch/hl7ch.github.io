<http://fhir.ch/ig/ch-ems/Observation/1-Alarm> a fhir:Observation ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "1-Alarm"] ; # 
  fhir:status [ fhir:v "final"] ; # 
