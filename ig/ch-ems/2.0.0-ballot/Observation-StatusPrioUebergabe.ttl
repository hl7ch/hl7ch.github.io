# - resource -------------------------------------------------------------------

<http://fhir.ch/ig/ch-ems/Observation/StatusPrioUebergabe> a fhir:Observation ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "StatusPrioUebergabe"] ; # 
  fhir:status [ fhir:v "final"] ; # 
  fhir:code [
     fhir:coding ( [
       a loinc:77941-3 ;
       fhir:system [ fhir:v "http://loinc.org"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "77941-3" ] ;
       fhir:display [ fhir:v "Final patient acuity NEMSIS" ]
     ] )
  ] ; # 
  fhir:subject [
     fhir:link <http://fhir.ch/ig/ch-ems/Patient/PatientExample> ;
     fhir:reference [ fhir:v "Patient/PatientExample" ]
  ] ; # 
  fhir:encounter [
     fhir:link <http://fhir.ch/ig/ch-ems/Encounter/EncounterExample> ;
     fhir:reference [ fhir:v "Encounter/EncounterExample" ]
  ] ; # 
  fhir:effective [
     a fhir:dateTime ;
     fhir:v "2016-12-10T12:25:00.000+01:00"^^xsd:dateTime
  ] ; # 
  fhir:value [
     a fhir:CodeableConcept ;
     fhir:coding ( [
       a sct:371244009 ;
       fhir:system [ fhir:v "http://snomed.info/sct"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "371244009" ] ;
       fhir:display [ fhir:v "Yellow color (qualifier value)" ]
     ] ) ;
     fhir:text [ fhir:v "gelb" ]
  ] . # 

