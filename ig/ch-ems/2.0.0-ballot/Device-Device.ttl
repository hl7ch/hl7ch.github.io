# - resource -------------------------------------------------------------------

<http://fhir.ch/ig/ch-ems/Device/Device> a fhir:Device ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "Device"] ; # 
  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Device Device</b></p><a name=\"Device\"> </a><a name=\"hcDevice\"> </a><p><b>CH EMS Extension: Owner</b>: <span title=\"Codes:{http://snomed.info/sct 116154003}\">Patient</span></p><h3>DeviceNames</h3><table class=\"grid\"><tr><td style=\"display: none\">-</td><td><b>Name</b></td><td><b>Type</b></td></tr><tr><td style=\"display: none\">*</td><td>Beatmungsgerät</td><td>User Friendly name</td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:extension ( [
     fhir:url [ fhir:v "http://fhir.ch/ig/ch-ems/StructureDefinition/ch-ems-ext-owner"^^xsd:anyURI ] ;
     fhir:value [
       a fhir:CodeableConcept ;
       fhir:coding ( [
         a sct:116154003 ;
         fhir:system [ fhir:v "http://snomed.info/sct"^^xsd:anyURI ] ;
         fhir:code [ fhir:v "116154003" ] ;
         fhir:display [ fhir:v "Patient (person)" ]
       ] ) ;
       fhir:text [ fhir:v "Patient" ]
     ]
  ] ) ; # 
  fhir:deviceName ( [
     fhir:name [ fhir:v "Beatmungsgerät" ] ;
     fhir:type [ fhir:v "user-friendly-name" ]
  ] ) . # 

