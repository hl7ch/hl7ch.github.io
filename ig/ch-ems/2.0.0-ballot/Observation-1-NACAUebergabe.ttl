# - resource -------------------------------------------------------------------

<http://fhir.ch/ig/ch-ems/Observation/1-NACAUebergabe> a fhir:Observation ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "1-NACAUebergabe"] ; # 
  fhir:status [ fhir:v "final"] ; # 
  fhir:code [
     fhir:coding ( [
       a loinc:88076-5 ;
       fhir:system [ fhir:v "http://loinc.org"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "88076-5" ] ;
       fhir:display [ fhir:v "Injury severity score NACA" ]
     ] )
  ] ; # 
  fhir:subject [
     fhir:link <http://fhir.ch/ig/ch-ems/Patient/1-ThomasMueller> ;
     fhir:reference [ fhir:v "Patient/1-ThomasMueller" ]
  ] ; # 
  fhir:encounter [
     fhir:link <http://fhir.ch/ig/ch-ems/Encounter/1-Einsatz> ;
     fhir:reference [ fhir:v "Encounter/1-Einsatz" ]
  ] ; # 
  fhir:value [
     a fhir:CodeableConcept ;
     fhir:coding ( [
       fhir:system [ fhir:v "http://fhir.ch/ig/ch-ems/CodeSystem/IVR"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "III" ] ;
       fhir:display [ fhir:v "mässige bis schwere Störung" ]
     ] ) ;
     fhir:text [ fhir:v "mässige bis schwere Störung" ]
  ] . # 

