  fhir:category [
     fhir:coding ( [
       a sct:232663008 ;
       fhir:system [ fhir:v "http://snomed.info/sct"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "232663008" ] ;
       fhir:display [ fhir:v "Airway procedure (procedure)" ]
     ] )
  ] ; # 
  fhir:code [
     fhir:coding ( [
       a sct:52765003 ;
       fhir:system [ fhir:v "http://snomed.info/sct"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "52765003" ] ;
       fhir:display [ fhir:v "Intubation (procedure)" ]
     ] ) ;
     fhir:text [ fhir:v "Intubation" ]
  ] ; # 
  fhir:subject [
     fhir:link <http://fhir.ch/ig/ch-ems/Patient/PatientExample> ;
     fhir:reference [ fhir:v "Patient/PatientExample" ]
  ] ; # 
  fhir:encounter [
