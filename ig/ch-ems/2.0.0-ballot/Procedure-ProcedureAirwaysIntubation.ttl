<http://fhir.ch/ig/ch-ems/Procedure/ProcedureAirwaysIntubation> a fhir:Procedure ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "ProcedureAirwaysIntubation"] ; # 
