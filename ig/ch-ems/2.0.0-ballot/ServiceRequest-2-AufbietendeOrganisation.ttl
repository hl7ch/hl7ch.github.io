     fhir:name [ fhir:v "SNZ" ]
  ] ) ; # 
  fhir:status [ fhir:v "completed"] ; # 
  fhir:intent [ fhir:v "order"] ; # 
  fhir:subject [
     fhir:link <http://fhir.ch/ig/ch-ems/Patient/2-PatientUnbekannt> ;
