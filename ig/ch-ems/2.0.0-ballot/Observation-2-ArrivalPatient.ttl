# - resource -------------------------------------------------------------------

<http://fhir.ch/ig/ch-ems/Observation/2-ArrivalPatient> a fhir:Observation ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "2-ArrivalPatient"] ; # 
  fhir:status [ fhir:v "final"] ; # 
  fhir:code [
     fhir:coding ( [
       fhir:system [ fhir:v "http://fhir.ch/ig/ch-ems/CodeSystem/IVR"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "1000037" ] ;
       fhir:display [ fhir:v "arrival patient" ]
     ] ) ;
     fhir:text [ fhir:v "Ankunftszeit beim Patienten" ]
  ] ; # 
  fhir:subject [
     fhir:link <http://fhir.ch/ig/ch-ems/Patient/2-PatientUnbekannt> ;
     fhir:reference [ fhir:v "Patient/2-PatientUnbekannt" ]
  ] ; # 
  fhir:encounter [
     fhir:link <http://fhir.ch/ig/ch-ems/Encounter/2-Einsatz> ;
     fhir:reference [ fhir:v "Encounter/2-Einsatz" ]
  ] ; # 
  fhir:value [
     a fhir:dateTime ;
     fhir:v "2016-12-10T12:17:00.000+01:00"^^xsd:dateTime
  ] . # 

