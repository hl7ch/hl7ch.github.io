           fhir:v "http://fhir.ch/ig/ch-ems/StructureDefinition/ch-ems-codeableconcept"^^xsd:anyURI ;
           fhir:link <http://fhir.ch/ig/ch-ems/StructureDefinition/ch-ems-codeableconcept>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "extensible" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.ch/ig/ch-ems/ValueSet/IVR-VS-idSource"^^xsd:anyURI ;
           fhir:link <http://fhir.ch/ig/ch-ems/ValueSet/IVR-VS-idSource>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Extension.url" ] ;
       fhir:path [ fhir:v "Extension.url" ] ;
       fhir:fixed [
         a fhir:uri ;
         fhir:v "http://fhir.ch/ig/ch-ems/StructureDefinition/ch-ems-ext-identification"^^xsd:anyURI
       ]
     ] [
       fhir:id [ fhir:v "Extension.value[x]" ] ;
       fhir:path [ fhir:v "Extension.value[x]" ] ;
       fhir:max [ fhir:v "0" ]
     ] )
  ] . # 

